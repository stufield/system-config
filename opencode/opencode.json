{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "default"
      }
    }
  },
  "enabled_providers": ["amazon-bedrock"],
  "default_agent": "main",
  "share": "disabled",
  "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
  "small_model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "basic": {
      "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
      "description": "Use for very basic prompting. Eventually this model will become obsolete.",
      "prompt": "Load and follow these skills in order: agent-behavior, caveman."
    },
    "main": {
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-5",
      "description": "This is the standard work-horse default. Use for standard work interactions.",
      "mode": "primary",
      "prompt": "Load and follow these skills in order: agent-behavior, caveman, coding, r-analysis."
    },
    "hard": {
      "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
      "description": "Use for complex debugging or architecture problems Sonnet 5 can't solve.",
      "mode": "all",
      "prompt": "Load and follow these skills in order: agent-behavior, caveman, coding, r-analysis."
    }
  },
  "skills": {
    "paths": [
      "/Users/sfield/.agents/skills",
      "/Users/sfield/github/agent-skills"
    ]
  },
  "permission": {
    "skill": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "sudo rm*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git branch -D": "ask",
      "git clean -fd*": "ask"
    },
    "external_directory": { "*": "ask" }
  },
  "mcp": {
    "fert": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/uv",
        "--directory",
        "FULL PATH TO the MCP REPO, example: /Users/sfield/cercle/git/dunno-where-this-is",
        "run",
        "python",
        "server.py"
      ],
      "enabled": false,
      "timeout": 300000
    }
  },
  "lsp": true
}
